# ============================================================
# Environment Configuration
# Copy this file to .env and fill in your values
# ============================================================

# --- Google Gemini API (REQUIRED) ---
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# --- Application Settings ---
APP_NAME="AI Resume Intelligence Platform"
APP_VERSION="1.0.0"
DEBUG=false

# --- Server ---
HOST=0.0.0.0
PORT=8000

# --- PostgreSQL Database ---
# Format: postgresql+asyncpg://user:password@host:port/dbname
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/resume_intelligence
# Sync URL used by Alembic migrations only
DATABASE_URL_SYNC=postgresql+psycopg2://postgres:password@localhost:5432/resume_intelligence

# --- Connection Pool ---
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# --- Redis Cache (L1 Embedding Cache) ---
REDIS_URL=redis://localhost:6379/0
REDIS_EMBEDDING_TTL=86400
REDIS_RESPONSE_TTL=43200

# --- Security ---
SECRET_KEY=change-this-to-a-random-secret-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- File Upload Settings ---
MAX_FILE_SIZE_MB=10
UPLOAD_DIR=uploads
ALLOWED_EXTENSIONS=pdf,docx,txt

# --- Embedding Model ---
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_CACHE_DIR=cache/embeddings

# --- FAISS ---
FAISS_INDEX_DIR=cache/faiss

# --- RAG Settings ---
CHUNK_SIZE=512
CHUNK_OVERLAP=50
TOP_K_RESULTS=5

# --- CORS ---
ALLOWED_ORIGINS=http://localhost:8501,http://localhost:3000

# --- Docker Compose Postgres Settings ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=resume_intelligence
